# ==============================================================================
# TACMAP Production Configuration (Debian 13 LXC)
# ==============================================================================

# Прив'язка до локального хоста (доступ тільки через Nginx reverse proxy)
HOST=127.0.0.1
PORT=8080

# Шляхи файлової системи Linux
DATA_DIR=/opt/tacmap/data
FRONTEND_DIR=/opt/tacmap/frontend

# Безпека та доступ
ENABLE_DEBUG=false
CORS_ORIGIN=*
# Необов'язковий токен для майбутніх адмінських дій
# API_SECRET_TOKEN=change_me_to_a_secure_random_string

# Затримка видачі даних (безпека та відповідність)
PUBLIC_DELAY_SEC=5
POLL_INTERVAL_SEC=30

# Радарні джерела (увімкнено / вимкнено)
ENABLE_DIMAP=true
ENABLE_SHAHMAP=true
ENABLE_RADARUA=true
ENABLE_AVIACONTROL=true

# Офіційні сповіщення ПС ЗСУ
ENABLE_OFFICIAL=true
OFFICIAL_CHANNELS=kpszsu
OFFICIAL_POLL_INTERVAL_SEC=10

# Логування (info, warn, error)
RUST_LOG=info
